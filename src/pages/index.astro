---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import WaterfallHero from '../components/WaterfallHero.astro';
import Stack from '../components/sections/Stack.astro';
import Parcours from '../components/sections/Parcours.astro';
import ServicesTeaser from '../components/sections/ServicesTeaser.astro';
import Contact from '../components/sections/Contact.astro';
import Faq from '../components/sections/Faq.astro';
import Field from '../components/Field.astro';
import ProjectsViewer from '../components/projets/ProjectsViewer.astro';
import kayak from '../assets/images/kayak.png';

const projets = (await getCollection('projets', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Layout>
	<WaterfallHero />

	<!-- ===================== Projets (même visionneuse que la page /projets) ===================== -->
	<ProjectsViewer projets={projets} current={0} embedded />

	<!-- ===================== À propos ===================== -->
	<section id="a-propos" class="section about" aria-labelledby="apropos-title">
		<div class="container about__grid">
			<figure class="about__photo" data-reveal>
				<Image
					src={kayak}
					alt="Kayak freestyle : figure dans une vague, le bateau dressé à la verticale."
					widths={[360, 650]}
					sizes="(min-width: 64rem) 40vw, 100vw"
					loading="lazy"
				/>
				<figcaption class="mono">Hors écran — kayak freestyle</figcaption>
			</figure>

			<div class="about__body" data-reveal style="--reveal-delay: 0.08s">
				<p class="mono label">À propos</p>
				<h2 id="apropos-title" class="about__title">
					Des outils pensés pour <span class="volt">ceux qui les utilisent.</span>
				</h2>
				<p>
					Formé en BUT MMI, je travaille depuis septembre 2026 en alternance dans une PME industrielle.
					J'y conçois des applications métier de bout en bout : recueil du besoin auprès des équipes,
					développement, mise en production et suivi.
				</p>
				<p>
					Ce qui me motive : comprendre comment les gens travaillent vraiment, et livrer un outil
					qu'ils ont envie d'ouvrir le matin. Le reste du temps, je suis sur l'eau ou sur un sentier.
				</p>
			</div>
		</div>
	</section>

	<Stack />
	<Parcours />
	<ServicesTeaser />
	<Faq />

	<Contact />
</Layout>

<style>
	/* En-têtes de section (.section, .sec-head, .sec-title…) : voir global.css */
	/* ---------- À propos ---------- */
	.about { border-top: 1px solid var(--line); }
	.about__grid {
		display: grid;
		gap: clamp(2.5rem, 5vw, 5rem);
		align-items: center;
	}
	.about__photo { margin: 0; }
	.about__photo img {
		width: 100%;
		height: auto;
		aspect-ratio: 650 / 666;
		object-fit: cover;
		border-radius: 2px;
	}
	.about__photo figcaption { margin-top: 0.75rem; color: var(--mist); }

	.about__body { display: grid; gap: 1.5rem; }
	.about__title {
		font-size: var(--step-3);
		font-weight: 900;
	}
	.about__body > p:not(.label) { max-width: 56ch; color: var(--mist); }

	@media (min-width: 64rem) {
		.about__grid { grid-template-columns: 0.8fr 1fr; }
	}

	/* Fiche technique façon catalogue de kayaks */
	.specs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		margin-top: var(--section);
		margin-bottom: 0;
	}
	.spec {
		padding: 1.5rem 1.25rem 1.5rem 0;
		border-top: 1px solid var(--line-strong);
	}
	.spec__value {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(3.5rem, 2rem + 5vw, 7rem);
		line-height: 0.9;
		text-transform: uppercase;
	}
	.spec__label {
		margin: 0.75rem 0 0;
		max-width: 26ch;
		color: var(--mist);
		font-size: var(--step--1);
	}
</style>
