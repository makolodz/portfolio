---

import '../styles/global.css';

---

<header class="header">
    <nav class="header--nav">
        <ul class="header--nav--ul">
            <li class="header--li"> <a id="accueil" href="/">Maxiko</a> </li>
            <div id="spacer" class="spacer"></div>
            <li class="header--li"> <a class="header--li--a" data-category="creations" href="">Réalisations</a></li>
            <li class="header--li"> <a class="header--li--a" data-category="veille" href="">Compétences</a></li>
            <li class="header--li"> <a class="header--li--a" data-category="blogs" href="">Qui suis-je ?</a></li>
            <li class="header--li"> <a class="header--li--a" data-category="blogs" href="">CV</a></li>            <li class="header--li"> <a class="randlink header--li--a" data-category="blogs" href="">Contact</a></li>
        </ul>
    </nav>
</header>


<style>

.header{
	font-family: jb-mono-regular;
    font-size: 16px;
	position: fixed;
	top: 0;
	width: calc(100% - 64px);
	padding: 32px;

    border-bottom: solid 2px var(--primary-foreground);
    background-color: var(--primary-background);
}

.header--nav {
	height: 44px;
	display: flex;
	justify-content: space-between;
}

.header--nav--ul {
	width: 100%;
	margin: 0px;
	display: flex;
	justify-content: flex-end;
	align-items: center;
	gap: 16px;
}

.header--li--a {
    border-radius: 4px;
    padding-inline: 2px;
    border: solid 1px rgba(0,0,0,0);
    transition: 0.15s;

}

.header--li--a:hover {
    transition: 0.15s;
    border: solid 1px var(--primary-foreground);
    background-color: rgba(0,0,0,0.1);
}

#accueil {
    font-family: jersey;
    font-size: xxx-large;
}
    
.spacer {
	flex: 1;
}

</style>