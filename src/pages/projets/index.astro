---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import ProjectsViewer from '../../components/projets/ProjectsViewer.astro';

const projets = (await getCollection('projets', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---

<Layout title="Projets" description="Études de cas : contexte, rôle, process et résultat de mes projets web.">
	<ProjectsViewer projets={projets} current={0} />
</Layout>
