---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import WaterfallHero from '../components/WaterfallHero.astro';
import { site } from '../data/site';
import kayak from '../assets/images/kayak.png';

const projets = (await getCollection('projets', ({ data }) => data.featured && !data.draft))
	.sort((a, b) => a.data.order - b.data.order);

const specs = [
	{ value: '1 an', label: "d'expérience en alternance au sein d'une PME industrielle pour la conception et améliorations d'applications métiers." },
	{ value: '3', label: "casquettes : Conception, Développement, Deploiement (j'en ai aussi une des yankees mais apparemment ça compte pas)" },
	{ value: 'MMI', label: "BUT Métiers du multimédia et de l'internet, une formation polyvalente qui m'a formé en conception ainsi qu'en développement pour livrer des applications utiles." },
	{ value: '1', label: "seul développeur de la boîte : du besoin jusqu’à la mise en prod, c’est moi (et le café)." },
];
---

<Layout>
	<WaterfallHero />

	<!-- ===================== Projets ===================== -->
	<section id="projets" class="section" aria-labelledby="projets-title">
		<div class="container">
			<header class="sec-head" data-reveal>
				<h2 id="projets-title" class="sec-title">
					Projets<sup class="sec-count mono">({String(projets.length).padStart(2, '0')})</sup>
				</h2>
				<p class="sec-note">Études de cas : le contexte, mon rôle, le process et le résultat.</p>
			</header>

			<ol class="rows">
				{projets.map((p, i) => (
					<li data-reveal style={`--reveal-delay: ${i * 0.06}s`}>
						<a class="row" href={`/projets/${p.id}`}>
							<span class="row__num mono">{String(i + 1).padStart(2, '0')}</span>
							<h3 class="row__title">
								{/* Pas de coupure au milieu d'un mot composé (« e-commerce ») */}
								{p.data.title.split(' ').map((word, k) => <>{k > 0 && ' '}<span class="nowrap">{word}</span></>)}
							</h3>
							<div class="row__info">
								<p class="row__meta mono">{p.data.client}{p.data.year && ` · ${p.data.year}`}</p>
								<p class="row__summary">{p.data.summary}</p>
								<ul class="row__tags mono" aria-label="Technologies">
									{p.data.stack.map((s) => <li>{s}</li>)}
								</ul>
							</div>
							<span class="row__arrow" aria-hidden="true">→</span>
						</a>
					</li>
				))}
			</ol>
		</div>
	</section>

	<!-- ===================== À propos ===================== -->
	<section id="a-propos" class="section about" aria-labelledby="apropos-title">
		<div class="container about__grid">
			<figure class="about__photo" data-reveal>
				<Image
					src={kayak}
					alt="Kayak freestyle : figure dans une vague, le bateau dressé à la verticale."
					widths={[360, 650]}
					sizes="(min-width: 64rem) 40vw, 100vw"
					loading="lazy"
				/>
				<figcaption class="mono">Hors écran — kayak freestyle</figcaption>
			</figure>

			<div class="about__body" data-reveal style="--reveal-delay: 0.08s">
				<p class="mono label">À propos</p>
				<h2 id="apropos-title" class="about__title">
					Des outils pensés pour <span class="volt">ceux qui les utilisent.</span>
				</h2>
				<p>
					Formé en BUT MMI, je travaille depuis un an en alternance dans une PME industrielle.
					J'y conçois des applications métier de bout en bout : recueil du besoin auprès des équipes,
					développement, mise en production et suivi.
				</p>
				<p>
					Ce qui me motive : comprendre comment les gens travaillent vraiment, et livrer un outil
					qu'ils ont envie d'ouvrir le matin. Le reste du temps, je suis sur l'eau ou sur un sentier.
				</p>
			</div>
		</div>

		<dl class="container specs">
			{specs.map((s, i) => (
				<div class="spec" data-reveal style={`--reveal-delay: ${i * 0.06}s`}>
					<dt class="spec__value">{s.value}</dt>
					<dd class="spec__label">{s.label}</dd>
				</div>
			))}
		</dl>
	</section>

	<!-- ===================== Contact ===================== -->
	<section id="contact" class="contact" aria-labelledby="contact-title">
		<div class="container contact__inner">
			<p class="mono contact__status"><span class="contact__dot"></span>{site.availability}</p>
			<h2 id="contact-title" class="contact__title" data-reveal>
				Un poste,<br />un projet ?<br />On en parle.
			</h2>
			<div class="contact__row" data-reveal style="--reveal-delay: 0.08s">
				<div>
					<p class="contact__lead">
						Recruteur, agence ou entreprise avec un besoin d'outil sur mesure : écrivez-moi.
					</p>
					<a class="contact__mail" href={`mailto:${site.email}`}>{site.email}</a>
				</div>
				<ul class="contact__links mono">
					<li><a href={site.linkedin} rel="noopener">LinkedIn ↗</a></li>
					<li><a href={site.github} rel="noopener">GitHub ↗</a></li>
					<li><a href={site.cv}>CV ↓</a></li>
				</ul>
			</div>
		</div>
	</section>
</Layout>

<style>
	.section { padding-block: var(--section); }
	.volt { color: var(--volt); }

	/* ---------- En-tête de section ---------- */
	.sec-head {
		display: grid;
		gap: 1.25rem;
		margin-bottom: clamp(2rem, 5vw, 4rem);
	}
	.sec-title {
		font-size: clamp(4rem, 2rem + 10vw, 12rem);
		font-weight: 900;
		line-height: 0.8;
	}
	.sec-count {
		margin-left: 0.4rem;
		font-size: var(--step--1);
		font-weight: 400;
		vertical-align: top;
		color: var(--volt);
	}
	.sec-note { max-width: 32ch; color: var(--mist); }
	@media (min-width: 64rem) {
		.sec-head { grid-template-columns: 1fr auto; align-items: end; }
	}

	/* ---------- Lignes projets ---------- */
	.rows { border-top: 1px solid var(--line-strong); }
	.rows > li { border-bottom: 1px solid var(--line-strong); }

	.row {
		position: relative;
		isolation: isolate;
		display: grid;
		grid-template-columns: auto 1fr auto;
		gap: 0.75rem 1.25rem;
		padding: clamp(1.5rem, 3vw, 2.5rem) clamp(0.25rem, 1vw, 1rem);
		text-decoration: none;
		transition: color 0.25s;
	}
	/* Remplissage jaune qui monte depuis le bas au survol */
	.row::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background: var(--volt);
		transform: scaleY(0);
		transform-origin: bottom;
		transition: transform 0.4s var(--ease);
	}
	.row:hover::before,
	.row:focus-visible::before { transform: scaleY(1); }
	.row:hover,
	.row:focus-visible { color: var(--deep); }
	.row:hover .row__meta, .row:hover .row__summary, .row:hover .row__num,
	.row:focus-visible .row__meta, .row:focus-visible .row__summary, .row:focus-visible .row__num { color: var(--deep); }
	.row:hover .row__tags li, .row:focus-visible .row__tags li { border-color: var(--deep); }
	.row:focus-visible { outline-color: var(--foam); }
	@media (prefers-reduced-motion: reduce) {
		.row::before { transition: none; }
	}

	.row__num { color: var(--mist); padding-top: 0.4rem; }
	.row__title {
		font-size: clamp(2.5rem, 1.5rem + 4.5vw, 6.5rem);
		font-weight: 800;
		line-height: 0.85;
	}
	.nowrap { white-space: nowrap; }
	.row__arrow {
		grid-column: 3;
		grid-row: 1;
		font-size: clamp(1.75rem, 1rem + 2vw, 3rem);
		line-height: 1;
		transition: transform 0.3s var(--ease);
	}
	.row:hover .row__arrow { transform: translateX(0.4rem) rotate(-45deg); }

	.row__info {
		grid-column: 2 / -1;
		grid-row: 2;
		display: grid;
		gap: 0.75rem;
	}
	.row__meta { color: var(--volt); }
	.row__summary { max-width: 52ch; color: var(--mist); }
	.row__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.7rem; }
	.row__tags li {
		padding: 0.25rem 0.65rem;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
	}

	@media (min-width: 64rem) {
		.row {
			grid-template-columns: 4rem 1.2fr 1fr 3rem;
			align-items: start;
			column-gap: 2.5rem;
		}
		.row__info { grid-column: 3; grid-row: 1; }
		.row__arrow { grid-column: 4; justify-self: end; }
	}

	/* ---------- À propos ---------- */
	.about { border-top: 1px solid var(--line); }
	.about__grid {
		display: grid;
		gap: clamp(2.5rem, 5vw, 5rem);
		align-items: center;
	}
	.about__photo { margin: 0; }
	.about__photo img {
		width: 100%;
		height: auto;
		aspect-ratio: 650 / 666;
		object-fit: cover;
		border-radius: 2px;
	}
	.about__photo figcaption { margin-top: 0.75rem; color: var(--mist); }

	.about__body { display: grid; gap: 1.5rem; }
	.about__title {
		font-size: var(--step-3);
		font-weight: 900;
	}
	.about__body > p:not(.label) { max-width: 56ch; color: var(--mist); }

	@media (min-width: 64rem) {
		.about__grid { grid-template-columns: 0.8fr 1fr; }
	}

	/* Fiche technique façon catalogue de kayaks */
	.specs {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
		margin-top: var(--section);
		margin-bottom: 0;
	}
	.spec {
		padding: 1.5rem 1.25rem 1.5rem 0;
		border-top: 1px solid var(--line-strong);
	}
	.spec__value {
		font-family: var(--font-display);
		font-weight: 900;
		font-size: clamp(3.5rem, 2rem + 5vw, 7rem);
		line-height: 0.9;
		text-transform: uppercase;
	}
	.spec__label {
		margin: 0.75rem 0 0;
		max-width: 26ch;
		color: var(--mist);
		font-size: var(--step--1);
	}

	/* ---------- Contact (bloc jaune) ---------- */
	.contact {
		background: var(--volt);
		color: var(--deep);
		padding-block: var(--section);
	}
	.contact :focus-visible { outline-color: var(--deep); }
	.contact ::selection { background: var(--deep); color: var(--volt); }

	.contact__inner { display: grid; gap: clamp(1.5rem, 3vw, 2.5rem); }
	.contact__status { display: inline-flex; align-items: center; gap: 0.7rem; }
	.contact__dot {
		width: 0.55rem;
		height: 0.55rem;
		border-radius: 50%;
		background: var(--deep);
	}
	.contact__title {
		font-size: var(--step-4);
		font-weight: 900;
		line-height: 0.84;
	}

	.contact__row {
		display: grid;
		gap: 2rem;
		padding-top: 1.5rem;
		border-top: 2px solid var(--deep);
	}
	.contact__lead { max-width: 42ch; font-size: var(--step-1); margin-bottom: 1rem; }
	.contact__mail {
		display: inline-block;
		font-family: var(--font-display);
		font-weight: 800;
		font-size: var(--step-2);
		text-transform: uppercase;
		text-decoration: underline;
		text-decoration-thickness: 3px;
		text-underline-offset: 0.15em;
		overflow-wrap: anywhere;
	}
	.contact__mail:hover { text-decoration-thickness: 6px; }

	.contact__links { display: flex; flex-wrap: wrap; gap: 0.5rem; align-self: end; }
	.contact__links a {
		display: inline-block;
		padding: 0.8rem 1.25rem;
		border: 1.5px solid var(--deep);
		border-radius: 999px;
		text-decoration: none;
		transition: background-color 0.2s, color 0.2s;
	}
	.contact__links a:hover { background: var(--deep); color: var(--volt); }

	@media (min-width: 64rem) {
		.contact__row { grid-template-columns: 1fr auto; }
	}
</style>
