<style>

#arrow-titre {
	display: flex;
	flex-direction: column;
	justify-content: flex-end;
	align-items: flex-end;
}

#hero {
	height: calc(100vh - 32 - 64px - 64px);
	justify-content: flex-start;
	align-items: flex-start;

	padding-inline: 64px;
	padding-top: 180px;
	padding-bottom: 90px;

	display: flex;
}

#hero-container {
	display: flex;
	justify-content: flex-start;
	flex-direction: column;
	
	gap: -4px;
}

#titre {
	font-family: jersey;
	font-size: 70pt;
	letter-spacing: 7px;
}

.glitch-letter {
	display: inline-block;
	width: 0.42em;
	text-align: center;

	transition: transform 0.25s ease, opacity 0.25s ease;
	transform-origin: center;
	backface-visibility: hidden;
}

#cv {
	height: calc(100vh - 64px);
	padding: 32px;
	display: flex;
	gap: 16px;
}

#actu {
	height: calc(100vh - 64px);
	padding: 32px;
	display: flex;
	gap: 16px;
}

.glitch-letter {
	display: inline-block;
	transition: transform 0.25s ease, opacity 0.25s ease;
	transform-origin: center;
	backface-visibility: hidden;
}

.glitch-letter.swap {
	transform: rotateX(90deg);
	opacity: 0.2;
}

.status {
	background-color: var(--secondary-background);

	border-width: 2px;
	border-radius: 32px;
	border-style: solid;

	width: fit-content;

	padding: 8px;
	padding-inline: 16px;
	font-size: 12pt;

	display: flex;
	justify-content: center;
	align-items: center;

	gap: 8px;
}

.status-dot {
	width: 14px;
	height: 14px;
	border-radius: 100%;
}

.status.green {
	border-color: var(--secondary-foreground);
	color: var(--secondary-foreground);
}

.status-dot.green {
	background-color: var(--secondary-foreground);
}

.cta {

	border-width: 2px;
	border-radius: 32px;
	border-style: solid;

	padding: 12px;
	padding-inline: 24px;
	font-size: 16pt;


	background-color: var(--primary-background);
	color: var(--primary-foreground);
	border-color: var(--primary-foreground);
}

.cta.green {

	background-color: var(--secondary-background);
	color: var(--secondary-foreground);
	border-color: var(--secopdary-foreground);

}
</style>

<script>
const letter = document.querySelector('.glitch-letter');

let isPolish = false;

function toggleLetter() {
	letter?.classList.add('swap');

setTimeout(() => {
    isPolish = !isPolish;
    letter.textContent = isPolish ? 'ł' : 'l';
    letter?.classList.remove('swap');
  }, 250);
}

// toutes les 4 secondes
setInterval(toggleLetter, 4000);

</script>